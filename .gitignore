# ============================================================
# 羊羊跑酷（Sheep Runner）忽略规则
# ------------------------------------------------------------
# 公开仓库策略（2026-11-03 确定）：
#   仓库 https://github.com/taylor000106/sheep-runner 是公开的，
#   只提交「正式交付内容」，内部开发资料一律留在本地。
#
# 纳入版本管理（不得忽略）：
#   - index.html / css/ / js/ / tools/   源码与构建脚本
#   - assets/                            正式素材（含 128/256/512 各档）
#   - dist/sheep-runner.html             正式交付物（唯一对外产物）
#   - docs/                              对外可见的设计与验收文档
#   - README.md
#
# 仅本地保留（不提交，也不删除）：
#   - .bj-agents/   验收脚本、测试截图、内部开发笔记
#   - archive/     历史归档（旧 ZIP、一次性脚本、废弃实验图，约 122MB）
# ============================================================

# ---------- 仅本地保留的开发资料 ----------
.bj-agents/
archive/

# ---------- Python 缓存与编译产物 ----------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ---------- 编辑器 / IDE ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- 操作系统临时文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 通用临时 / 备份 / 日志 ----------
*.tmp
*.temp
*.bak
*.orig
*.rej
*.log
*~

# ---------- 依赖目录（当前项目内无；防止将来误装） ----------
node_modules/
.venv/
venv/

# ---------- 设计参考原图（体量大、非交付物，仅本地保留） ----------
design/

# ---------- 预览目录里的内测截图 / QA 对比图（仅本地；正式预览见 run_*.gif） ----------
assets/preview/ingame_*
assets/preview/qa_*
